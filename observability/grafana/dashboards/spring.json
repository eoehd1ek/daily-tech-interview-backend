{
  "uid": "tech-spring",
  "title": "Tech Backend Metrics",
  "description": "Single-server Spring Boot metrics collected by Alloy. API panels exclude Actuator requests. HTTP panels require traffic; p95 requires classic histogram buckets. Missing data is not a healthy status.",
  "tags": ["tech", "spring-boot", "metrics"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Backend Scrape Status",
      "description": "1 = successful scrape, 0 = failed scrape. No data can indicate an Alloy or remote-write outage.",
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 4},
      "datasource": {"type": "prometheus", "uid": "tech-prometheus"},
      "targets": [{"refId": "A", "expr": "up{job=\"tech-backend\",application=\"tech\"}", "instant": true}],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "noValue": "Unknown",
          "mappings": [{"type": "value", "options": {"0": {"text": "Down", "color": "red"}, "1": {"text": "Up", "color": "green"}}}],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        },
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none"}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Process CPU Usage",
      "gridPos": {"x": 8, "y": 0, "w": 8, "h": 4},
      "datasource": {"type": "prometheus", "uid": "tech-prometheus"},
      "targets": [{"refId": "A", "expr": "process_cpu_usage{job=\"tech-backend\",application=\"tech\"}", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "graphMode": "none"}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "JVM Live Threads",
      "gridPos": {"x": 16, "y": 0, "w": 8, "h": 4},
      "datasource": {"type": "prometheus", "uid": "tech-prometheus"},
      "targets": [{"refId": "A", "expr": "jvm_threads_live_threads{job=\"tech-backend\",application=\"tech\"}", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "decimals": 0}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "graphMode": "none"}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "JVM Heap",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "tech-prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum(jvm_memory_used_bytes{job=\"tech-backend\",application=\"tech\",area=\"heap\"})", "legendFormat": "Used"},
        {"refId": "B", "expr": "sum(jvm_memory_committed_bytes{job=\"tech-backend\",application=\"tech\",area=\"heap\"})", "legendFormat": "Committed"},
        {"refId": "C", "expr": "sum(jvm_memory_max_bytes{job=\"tech-backend\",application=\"tech\",area=\"heap\"} > 0)", "legendFormat": "Max (known pools)"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "API Request Rate",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "tech-prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (method, uri) (rate(http_server_requests_seconds_count{job=\"tech-backend\",application=\"tech\",uri!~\"/actuator.*\"}[$__rate_interval]))", "legendFormat": "{{method}} {{uri}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "API Latency p95",
      "description": "Classic histogram estimate per method and URI template. Empty or NaN is expected before requests; the configured histogram range is 1 ms to 180 s.",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "tech-prometheus"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, method, uri) (rate(http_server_requests_seconds_bucket{job=\"tech-backend\",application=\"tech\",uri!~\"/actuator.*\"}[$__rate_interval])))", "legendFormat": "{{method}} {{uri}}"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "API 5xx Rate",
      "description": "Server-error responses per second, not an error percentage. No series is expected before the first 5xx response.",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "tech-prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (method, uri, status) (rate(http_server_requests_seconds_count{job=\"tech-backend\",application=\"tech\",uri!~\"/actuator.*\",status=~\"5..\"}[$__rate_interval]))", "legendFormat": "{{status}} {{method}} {{uri}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "HikariCP Connections",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "tech-prometheus"},
      "targets": [
        {"refId": "A", "expr": "hikaricp_connections_active{job=\"tech-backend\",application=\"tech\"}", "legendFormat": "{{pool}} active"},
        {"refId": "B", "expr": "hikaricp_connections_pending{job=\"tech-backend\",application=\"tech\"}", "legendFormat": "{{pool}} pending"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "decimals": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "GC Pause Time Rate",
      "description": "Reported GC pause seconds per wall-clock second. No series may be present until the first GC event.",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "tech-prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (action, cause) (rate(jvm_gc_pause_seconds_sum{job=\"tech-backend\",application=\"tech\"}[$__rate_interval]))", "legendFormat": "{{action}} / {{cause}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    }
  ]
}
