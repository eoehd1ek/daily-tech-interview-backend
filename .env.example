DB_HOST=localhost:5432
POSTGRES_DB=tech
POSTGRES_USER=tech
POSTGRES_PASSWORD=pg-change-me

CHAT_BASE_URL=https://openrouter.ai/api/v1
CHAT_API_KEY=sk-or-KEYS
CHAT_MODEL=gpt-6-luna

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Required at startup. Password is only used when this administrator does not exist.
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=replace-with-a-unique-admin-password
# Set true for HTTPS deployment; false is for local HTTP only.
SESSION_COOKIE_SECURE=false

# Metrics demo stack. Grafana is only published on localhost.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-unique-grafana-password
GRAFANA_PORT=3000
BACKEND_PORT=8080
MANAGEMENT_SERVER_PORT=9091
# Local JVM binds management to loopback; Compose overrides this inside its private network.
MANAGEMENT_SERVER_ADDRESS=127.0.0.1
